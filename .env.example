# Local configuration. Copy to .env.local and fill in, then restart Metro
# (EXPO_PUBLIC_ values are baked into the JavaScript bundle at build time).

# ─── PawPal API ───────────────────────────────────────────────────────────────
# The API's base URL, e.g. https://api.pawpal.example. Required in preview and
# production builds, over HTTPS (the app stops at launch without it). Leave it
# empty in development to use the API on the computer running Metro, port 4000
# (`npm run dev` in PawPalBackend): localhost on web, Metro's address on a phone.
EXPO_PUBLIC_API_URL=

# ─── Firebase (sign-in SMS and Android push) ──────────────────────────────────
# Paths to your Firebase project's config files (for EAS builds, file-type EAS
# environment variables). Android push needs google-services.json; without it
# development builds just skip push registration.
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=

# ─── Direct UPI (default) ─────────────────────────────────────────────────────
# Customers pay this UPI ID from their own UPI app (GPay, PhonePe, Paytm, BHIM)
# and confirm with the 12-digit UPI reference. Defaults to aefuzz16-3@okhdfcbank.
EXPO_PUBLIC_UPI_VPA=
# Name shown in the customer's UPI app. Defaults to "PawPal".
EXPO_PUBLIC_UPI_PAYEE_NAME=

# ─── YouPI gateway (optional) ─────────────────────────────────────────────────
# Set this to use a self-hosted YouPI PG (github.com/youpi-pg/YouPI-PG) instead:
# its checkout portal URL, which also serves the /api/v1 payment API. Payments
# are then confirmed by the gateway, so customers don't type a reference.
# Local test gateway (`npm run youpi:test-server`): http://<this-computer's-LAN-IP>:7000
# Release builds need HTTPS here (Android blocks plain-HTTP requests in release builds).
EXPO_PUBLIC_YOUPI_URL=

# Only if your gateway hosts more than one merchant (Merchant Admin → merchant id).
EXPO_PUBLIC_YOUPI_MERCHANT_ID=

# ─── Build & release (see app.config.ts / eas.json) ───────────────────────────
# For EAS builds set these as EAS environment variables instead of here.
# development | preview | production (default). Each eas.json profile sets it.
APP_VARIANT=
# Store identifier (iOS bundle id and Android package). Must be decided and set
# before the first store build; defaults to the placeholder com.example.pawpal.
APP_BUNDLE_ID=
# EAS project id (from `eas init`); turns on EAS Update.
EXPO_PUBLIC_EAS_PROJECT_ID=

# ─── Crash reporting (Sentry, optional) ───────────────────────────────────────
# Crash reporting is off unless the DSN is set.
EXPO_PUBLIC_SENTRY_DSN=
# Source map uploads during release builds. Never commit the auth token: use an
# EAS secret. Without it the upload step is skipped.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
