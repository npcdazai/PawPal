# UPI payments. Copy to .env.local and fill in, then restart Metro
# (EXPO_PUBLIC_ values are baked into the JavaScript bundle at build time).

# ─── Direct UPI (default) ─────────────────────────────────────────────────────
# Customers pay this UPI ID from their own UPI app (GPay, PhonePe, Paytm, BHIM)
# and confirm with the 12-digit UPI reference. Defaults to aefuzz16-3@okhdfcbank.
EXPO_PUBLIC_UPI_VPA=
# Name shown in the customer's UPI app. Defaults to "PawPal".
EXPO_PUBLIC_UPI_PAYEE_NAME=

# ─── YouPI gateway (optional) ─────────────────────────────────────────────────
# Set this to use a self-hosted YouPI PG (github.com/youpi-pg/YouPI-PG) instead:
# its checkout portal URL, which also serves the /api/v1 payment API. Payments
# are then confirmed by the gateway, so customers don't type a reference.
# Local test gateway (`npm run youpi:test-server`): http://<this-computer's-LAN-IP>:7000
# Release builds need HTTPS here (Android blocks plain-HTTP requests in release builds).
EXPO_PUBLIC_YOUPI_URL=

# Only if your gateway hosts more than one merchant (Merchant Admin → merchant id).
EXPO_PUBLIC_YOUPI_MERCHANT_ID=
